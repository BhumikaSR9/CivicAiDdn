# ─── CivicAI Environment Configuration ───
# Copy this to .env and fill in your values.

# ─── App ───
APP_NAME=CivicAI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ─── Database ───
# SQLite (dev): sqlite+aiosqlite:///./civicai.db
# PostgreSQL (prod): postgresql+asyncpg://user:pass@localhost:5432/civicai
DATABASE_URL=sqlite+aiosqlite:///./civicai.db

# ─── Auth / JWT ───
SECRET_KEY=CHANGE-ME-TO-A-RANDOM-64-CHAR-STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── File Uploads ───
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ─── CORS ───
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ───
RATE_LIMIT_PER_MINUTE=60

# ─── ML ───
USE_FALLBACK_ONLY=false
ML_WEIGHTS_DIR=./ml/weights
CLIP_MODEL=MobileCLIP-S0
MINILM_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ─── Geocoding ───
NOMINATIM_USER_AGENT=civicai-dev
NOMINATIM_RATE_LIMIT_MS=1100

# ─── City Config ───
CITY_CONFIG_PATH=./config/city.json

# ─── Email (optional) ───
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@civicai.city

# ─── LLM (optional, for Ask CivicAI chatbot) ───
# LLM_API_KEY=
# LLM_MODEL=gemini-2.0-flash
